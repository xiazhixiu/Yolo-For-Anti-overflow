# ==================== 应用配置 ====================
# 视频源配置
# 支持本地视频文件路径或RTSP流地址
# 本地文件示例: ./train-video2/h2.mp4
# RTSP流示例: rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
VIDEO_SOURCE=./zyx_recording/1.mp4

# VIDEO_SOURCE=./eventvideos/1234.mp4
# VIDEO_SOURCE=../records/521-4-1.mp4

# VIDEO_SOURCE=./train-video2/h3.mp4

# 串口配置
# Windows系统: COM3, COM4 等
# Linux系统: /dev/ttyACM0, /dev/ttyUSB0 等
SERIAL_PORT=COM3

# 模型路径配置
# 支持本地模型文件路径或预训练模型名称
# 本地模型示例: ./best.pt, ./runs/detect/train/weights/best.pt
# 预训练模型示例: yolov8n.pt, yolov8s.pt, yolov8m.pt
# MODEL_PATH=./train12/weights/best.pt
MODEL_PATH=./best.pt
# MODEL_PATH=./best_int8_openvino_model/

# MODEL_PATH=./best.pt


# ==================== 可选配置 ====================
# 日志目录
LOG_DIR=./logs

# 串口波特率
SERIAL_BAUDRATE=9600

# 串口超时时间（秒）
SERIAL_TIMEOUT=1

# 污渍检测清晰度阈值
CLARITY_THRESHOLD=10

# 污渍检测帧数阈值
BLUR_THRESHOLD=30

# 喷水冷却时间（秒）
SPRAY_COOLDOWN=3600

# 危险检测比例阈值
DANGER_RATIO_THRESHOLD=0.9

# 危险检测时间阈值（秒）
DANGER_THRESHOLD=1

# 安全检测比例阈值
SAFETY_RATIO_THRESHOLD=0.3

# 安全检测时间阈值（秒）
SAFETY_THRESHOLD=2

# 物体跟踪配置
STOP_THRESHOLD=15

# 物体移动距离阈值（像素）
MOVE_EPSILON=10

# 二阶段位置固定前等待时间（秒）
FREEZE_SECONDS=1

# 串口开机自动启动
SERIAL_AUTO_START=false

# 二阶段位置固定前等待时间（秒）
FREEZE_SECONDS=30

# YOLO模型推理参数
YOLO_CONF=0.25
YOLO_IMGSZ=640

# FPS更新间隔（帧数）
FPS_UPDATE_INTERVAL=100

# 日志输出间隔（秒）
LOG_INTERVAL=600
